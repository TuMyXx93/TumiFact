---
import EmpleadoManager from '../components/empleados/EmpleadoManager';
import Layout from '../layouts/Layout.astro';
import db from '../lib/db.js';

const currentUser = Astro.locals.user as any;

// Protección RBAC en SSR: Solo Admin o Gerente
if (!currentUser || (currentUser.rol_nombre !== 'admin' && currentUser.rol_nombre !== 'gerente')) {
  return Astro.redirect('/');
}

let empleados = [];
let roles = [];
let tiposDoc = [];

try {
  const [empRes, rolesRes, tiposRes] = await Promise.all([
    db.query(`
      SELECT 
        COALESCE(e.id, u.id) as id,
        u.id as usuario_id,
        u.nombre,
        u.apellido,
        u.email,
        u.telefono,
        u.numero_identificacion,
        ti.codigo as tipo_identificacion,
        u.tipo_identificacion_id,
        u.rol_id,
        r.nombre as rol_nombre,
        COALESCE(e.cargo, CASE WHEN r.nombre = 'admin' THEN 'Administrador General' WHEN r.nombre = 'gerente' THEN 'Gerente de Tienda' ELSE 'Vendedor/Cajero' END) as cargo,
        COALESCE(e.departamento, CASE WHEN r.nombre = 'admin' THEN 'Dirección' WHEN r.nombre = 'gerente' THEN 'Operaciones' ELSE 'Ventas' END) as departamento,
        COALESCE(e.salario, 0) as salario,
        COALESCE(e.turno, 'completo') as turno,
        COALESCE(e.descuento_max_porcentaje, CASE WHEN r.nombre = 'admin' THEN 100.00 WHEN r.nombre = 'gerente' THEN 30.00 ELSE 10.00 END) as descuento_max_porcentaje,
        COALESCE(e.descuento_max_monto, CASE WHEN r.nombre = 'admin' THEN 99999999.00 WHEN r.nombre = 'gerente' THEN 500000.00 ELSE 50000.00 END) as descuento_max_monto,
        u.activo,
        u.ultimo_login,
        COALESCE(e.created_at, u.created_at) as created_at
      FROM usuarios u
      LEFT JOIN empleados e ON e.usuario_id = u.id
      LEFT JOIN roles r ON u.rol_id = r.id
      LEFT JOIN tipos_identificacion ti ON u.tipo_identificacion_id = ti.id
      ORDER BY u.id ASC
    `),
    db.query('SELECT * FROM roles ORDER BY id ASC'),
    db.query('SELECT * FROM tipos_identificacion ORDER BY id ASC'),
  ]);

  empleados = empRes.rows.map((e) => ({
    ...e,
    salario: parseFloat(e.salario || '0'),
    descuento_max_porcentaje: parseFloat(e.descuento_max_porcentaje || '0'),
    descuento_max_monto: parseFloat(e.descuento_max_monto || '0'),
  }));
  roles = rolesRes.rows || [];
  tiposDoc = tiposRes.rows || [];
} catch (e) {
  console.error('Error al consultar empleados SSR:', e);
}
---

<Layout title="Gestión de Empleados & Auditoría — TumiFact">
  <div class="space-y-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-6">
      <div>
        <h1 class="text-2xl font-bold font-['Outfit'] text-white">
          👥 Gestión de Empleados & Equipo
        </h1>
        <p class="text-slate-400 text-sm mt-1">
          Directorio del personal, asignación de roles RBAC, métricas de ventas y auditoría forense de operaciones.
        </p>
      </div>
    </div>

    <!-- React Island de Gestión de Empleados -->
    <EmpleadoManager 
      client:load 
      initialEmpleados={empleados} 
      initialRoles={roles} 
      initialTiposDoc={tiposDoc} 
    />
  </div>
</Layout>
