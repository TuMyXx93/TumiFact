---
import Layout from '../layouts/Layout.astro';
import WhiteLabelStudio from '../components/configuracion/WhiteLabelStudio';
import db from '../lib/db.js';

let config = {
  nombre_negocio: 'TumiFact Store',
  direccion: 'Calle 100 #15-20, Bogotá',
  telefono: '+57 300 123 4567',
  nit: '900.123.456-7',
  pie_pagina: '¡Gracias por su compra! Guarde este comprobante fiscal.',
  ancho_papel: 80,
  font_size: 1,
  mensaje_bienvenida: '¡Bienvenido a nuestro establecimiento!',
  politica_devolucion: 'Cambios y devoluciones dentro de los 30 días con el comprobante de compra.',
  politica_separados: 'Plazo máximo de separado: 30 a 45 días. Abonos no reembolsables si vence el plazo.',
  esquema_colores: {
    primary: '#3b82f6',
    secondary: '#0891b2',
    accent: '#10b981',
    background: '#060913',
    surface: '#0d1424'
  }
};

try {
  const result = await db.query('SELECT * FROM configuracion_impresion LIMIT 1');
  if (result.rows && result.rows.length > 0) {
    config = { ...config, ...result.rows[0] };
  }
} catch (e) {
  console.error('Error cargando configuración en Astro:', e);
}
---

<Layout title="Motor de Marca Blanca & Configuración — TumiFact 2026">
  <div class="space-y-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-6">
      <div>
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-purple-500/10 text-purple-400 border border-purple-500/20 uppercase tracking-wider">
            BRAND-SETTINGS • SPEC-2026
          </span>
        </div>
        <h1 class="text-2xl md:text-3xl font-extrabold font-['Space_Grotesk'] text-white tracking-tight mt-1">
          Motor de Marca Blanca & Identidad
        </h1>
        <p class="text-slate-400 text-xs sm:text-sm mt-1">
          Personalización en tiempo real de temas CSS, colores de acento, datos fiscales y tiquetes térmicos ESC/POS con código QR.
        </p>
      </div>
    </div>

    <!-- React Island de Marca Blanca -->
    <WhiteLabelStudio client:load initialConfig={config} />
  </div>
</Layout>

