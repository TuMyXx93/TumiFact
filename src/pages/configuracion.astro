---
import Layout from '../layouts/Layout.astro';
import db from '../lib/db.js';

let config = {
  nombre_negocio: 'TumiFact Enterprise',
  direccion: 'Calle Principal #10-20',
  telefono: '+57 300 123 4567',
  nit: '901.234.567-8',
  pie_pagina: '¡Gracias por su compra! Garantía y calidad garantizadas.',
  ancho_papel: 80,
  font_size: 1
};

try {
  const result = await db.query('SELECT * FROM configuracion_impresion LIMIT 1');
  if (result.rows && result.rows.length > 0) {
    config = { ...config, ...result.rows[0] };
  }
} catch (e) {
  console.error('Error cargando configuración en Astro:', e);
}
---

<Layout title="Configuración de Empresa — TumiFact">
  <div class="max-w-4xl mx-auto space-y-8">
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-slate-800 pb-6">
      <div>
        <h1 class="text-2xl font-bold font-['Outfit'] text-white">
          ⚙️ Configuración del Negocio
        </h1>
        <p class="text-slate-400 text-sm mt-1">
          Ajustes generales de datos fiscales, tiquetes térmicos de impresión y personalización.
        </p>
      </div>
      <span class="px-3 py-1 bg-blue-500/10 text-blue-400 border border-blue-500/20 text-xs font-semibold rounded-full">
        SSR Server Rendered
      </span>
    </div>

    <!-- Formulario de Configuración -->
    <form action="http://localhost:3000/api/configuracion" method="POST" enctype="multipart/form-data" class="bg-slate-900/60 border border-slate-800 p-6 md:p-8 rounded-2xl space-y-6 shadow-xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="space-y-2">
          <label for="nombre_negocio" class="text-xs font-semibold text-slate-300 uppercase tracking-wider">
            Nombre del Negocio *
          </label>
          <input
            type="text"
            id="nombre_negocio"
            name="nombre_negocio"
            value={config.nombre_negocio}
            required
            class="w-full px-4 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white text-sm focus:outline-none focus:border-blue-500 transition-colors"
          />
        </div>

        <div class="space-y-2">
          <label for="nit" class="text-xs font-semibold text-slate-300 uppercase tracking-wider">
            NIT / Cédula Fiscal
          </label>
          <input
            type="text"
            id="nit"
            name="nit"
            value={config.nit}
            class="w-full px-4 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white text-sm focus:outline-none focus:border-blue-500 transition-colors"
          />
        </div>

        <div class="space-y-2">
          <label for="telefono" class="text-xs font-semibold text-slate-300 uppercase tracking-wider">
            Teléfono de Contacto
          </label>
          <input
            type="text"
            id="telefono"
            name="telefono"
            value={config.telefono}
            class="w-full px-4 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white text-sm focus:outline-none focus:border-blue-500 transition-colors"
          />
        </div>

        <div class="space-y-2">
          <label for="ancho_papel" class="text-xs font-semibold text-slate-300 uppercase tracking-wider">
            Ancho de Papel Impresora (mm)
          </label>
          <select
            id="ancho_papel"
            name="ancho_papel"
            class="w-full px-4 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white text-sm focus:outline-none focus:border-blue-500 transition-colors"
          >
            <option value="80" selected={config.ancho_papel === 80}>80 mm (Estándar Térmico)</option>
            <option value="58" selected={config.ancho_papel === 58}>58 mm (POS Pequeño)</option>
          </select>
        </div>
      </div>

      <div class="space-y-2">
        <label for="direccion" class="text-xs font-semibold text-slate-300 uppercase tracking-wider">
          Dirección Comercial
        </label>
        <input
          type="text"
          id="direccion"
          name="direccion"
          value={config.direccion}
          class="w-full px-4 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white text-sm focus:outline-none focus:border-blue-500 transition-colors"
        />
      </div>

      <div class="space-y-2">
        <label for="pie_pagina" class="text-xs font-semibold text-slate-300 uppercase tracking-wider">
          Mensaje de Pie de Página en Tiquete
        </label>
        <textarea
          id="pie_pagina"
          name="pie_pagina"
          rows="3"
          class="w-full px-4 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white text-sm focus:outline-none focus:border-blue-500 transition-colors resize-none"
        >{config.pie_pagina}</textarea>
      </div>

      <!-- Carga de Archivos Logo y QR -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-slate-800">
        <div class="space-y-2">
          <label for="logo" class="text-xs font-semibold text-slate-300 uppercase tracking-wider">
            Logo de la Empresa (JPG/PNG)
          </label>
          <input
            type="file"
            id="logo"
            name="logo"
            accept="image/*"
            class="w-full text-xs text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-500"
          />
        </div>

        <div class="space-y-2">
          <label for="qr" class="text-xs font-semibold text-slate-300 uppercase tracking-wider">
            Código QR de Pagos (JPG/PNG)
          </label>
          <input
            type="file"
            id="qr"
            name="qr"
            accept="image/*"
            class="w-full text-xs text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-500"
          />
        </div>
      </div>

      <div class="flex justify-end pt-4">
        <button
          type="submit"
          class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-500 hover:to-cyan-400 text-white font-semibold text-sm shadow-lg shadow-blue-500/25 transition-all transform hover:-translate-y-0.5"
        >
          Guardar Configuración
        </button>
      </div>
    </form>
  </div>
</Layout>
