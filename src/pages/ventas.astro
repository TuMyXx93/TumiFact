---
import POSTerminal from '../components/pos/POSTerminal';
import Layout from '../layouts/Layout.astro';
import { db } from '../lib/db.js';

let productos = [];
let clientes = [];

try {
  const [prodRes, cliRes] = await Promise.all([
    db.query(`
      SELECT p.*, c.nombre as categoria_nombre, c.tipo as categoria_tipo
      FROM productos p
      LEFT JOIN categorias_producto c ON p.categoria_id = c.id
      WHERE p.activo = true
      ORDER BY p.nombre ASC
    `),
    db.query(`
      SELECT c.*, t.codigo as tipo_identificacion_codigo
      FROM clientes c
      LEFT JOIN tipos_identificacion t ON c.tipo_identificacion_id = t.id
      WHERE c.activo = true
      ORDER BY c.nombre, c.apellido ASC
    `),
  ]);

  productos = prodRes.rows || [];
  clientes = cliRes.rows || [];
} catch (e) {
  console.error('Error cargando datos SSR para Terminal POS:', e);
}

const user = Astro.locals.user as any;
---

<Layout title="Terminal POS — TumiFact v2.0">
  <div class="space-y-6">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-5">
      <div>
        <h1 class="text-2xl font-extrabold font-['Outfit'] text-white tracking-tight flex items-center gap-2.5">
          <span class="p-2 rounded-xl bg-blue-500/10 text-blue-400 border border-blue-500/20">
            ⚡
          </span>
          Terminal Punto de Venta (POS)
        </h1>
        <p class="text-slate-400 text-xs mt-1">
          Emisión de facturas en tiempo real con descuentos por ítem, precios mayoristas y soporte de separados.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/separados"
          class="px-3.5 py-2 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/30 text-amber-300 text-xs font-bold transition-all"
        >
          📋 Ver Separados
        </a>
        <a
          href="/caja"
          class="px-3.5 py-2 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 text-emerald-300 text-xs font-bold transition-all"
        >
          💰 Control de Caja
        </a>
      </div>
    </div>

    <!-- Terminal POS React Island v2 -->
    <POSTerminal
      client:load
      initialProductos={productos}
      initialClientes={clientes}
      user={user}
    />
  </div>
</Layout>
