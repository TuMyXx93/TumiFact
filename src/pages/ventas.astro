---
import Layout from '../layouts/Layout.astro';
import db from '../lib/db.js';

let productos = [];
let clientes = [];

try {
  const prodRes = await db.query('SELECT * FROM productos ORDER BY nombre ASC');
  const cliRes = await db.query('SELECT * FROM clientes ORDER BY nombre ASC');
  productos = prodRes.rows || [];
  clientes = cliRes.rows || [];
} catch (e) {
  console.error('Error cargando datos para ventas:', e);
}
---

<Layout title="Facturación / Caja POS — TumiFact">
  <div class="space-y-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-6">
      <div>
        <h1 class="text-2xl font-bold font-['Outfit'] text-white">
          💳 Módulo de Facturación / Caja POS
        </h1>
        <p class="text-slate-400 text-sm mt-1">
          Emisión de ventas en tiempo real con recálculo automático de subtotales y totales.
        </p>
      </div>
      <div class="flex items-center gap-3">
        <span class="px-3 py-1 bg-amber-500/10 text-amber-400 border border-amber-500/20 text-xs font-semibold rounded-full">
          React Island (<code class="text-xs">client:load</code>)
        </span>
      </div>
    </div>

    <!-- Contenedor Base POS -->
    <div class="bg-slate-900/60 border border-slate-800 p-6 md:p-8 rounded-2xl space-y-6 shadow-xl">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Formulario Selección Cliente / Producto -->
        <div class="lg:col-span-2 space-y-6">
          <div class="space-y-2">
            <label class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Cliente de la Factura</label>
            <select class="w-full px-4 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white text-sm focus:outline-none focus:border-blue-500">
              <option value="">-- Seleccionar Cliente --</option>
              {clientes.map(c => (
                <option value={c.id}>{c.nombre} ({c.telefono || 'Sin tel.'})</option>
              ))}
            </select>
          </div>

          <div class="space-y-4">
            <h3 class="text-sm font-semibold text-slate-200 uppercase tracking-wider">Ítems de Venta</h3>
            <div class="p-8 border-2 border-dashed border-slate-800 rounded-xl text-center space-y-3">
              <p class="text-slate-400 text-sm">
                En la <strong>Fase 3</strong>, esta sección se convertirá en la <strong>React Island &lt;BillingPOS client:load /&gt;</strong> con autocompletado en tiempo real y cálculo instantáneo.
              </p>
              <a href="/productos" class="inline-block px-4 py-2 rounded-xl bg-slate-800 text-blue-400 text-xs font-semibold hover:bg-slate-700 transition-colors">
                Ver Catálogo de Productos →
              </a>
            </div>
          </div>
        </div>

        <!-- Panel de Totales y Pago -->
        <div class="bg-slate-950/80 border border-slate-800 p-6 rounded-xl flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <h3 class="text-sm font-bold text-white font-['Outfit'] border-b border-slate-800 pb-3">Resumen de Cuenta</h3>
            <div class="flex justify-between text-sm text-slate-400">
              <span>Subtotal:</span>
              <span class="font-semibold text-white">$0</span>
            </div>
            <div class="flex justify-between text-sm text-slate-400">
              <span>Descuento:</span>
              <span class="font-semibold text-white">$0</span>
            </div>
            <div class="flex justify-between text-lg font-bold text-emerald-400 pt-3 border-t border-slate-800">
              <span>TOTAL FACTURA:</span>
              <span>$0</span>
            </div>
          </div>

          <button disabled class="w-full py-3 rounded-xl bg-slate-800 text-slate-500 font-semibold text-sm cursor-not-allowed">
            Generar Factura (Disponible en Fase 3)
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>
