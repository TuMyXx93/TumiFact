---
import Layout from '../layouts/Layout.astro';
import BillingPOS from '../components/facturacion/BillingPOS';
import db from '../lib/db.js';

let productos = [];
let clientes = [];

try {
  const prodRes = await db.query('SELECT * FROM productos ORDER BY nombre ASC');
  const cliRes = await db.query('SELECT * FROM clientes ORDER BY nombre ASC');
  productos = prodRes.rows || [];
  clientes = cliRes.rows || [];
} catch (e) {
  console.error('Error cargando datos SSR para ventas:', e);
}
---

<Layout title="Facturación / Caja POS — TumiFact">
  <div class="space-y-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-6">
      <div>
        <h1 class="text-2xl font-bold font-['Outfit'] text-white">
          💳 Módulo de Facturación / Caja POS
        </h1>
        <p class="text-slate-400 text-sm mt-1">
          Emisión de ventas en tiempo real con recálculo automático de subtotales, cambio y registro directo en PostgreSQL.
        </p>
      </div>
    </div>

    <!-- React Island Hidratada -->
    <BillingPOS client:load initialProductos={productos} initialClientes={clientes} />
  </div>
</Layout>
