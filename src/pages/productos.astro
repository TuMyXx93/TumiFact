---
import Layout from '../layouts/Layout.astro';
import ProductGrid from '../components/productos/ProductGrid';
import db from '../lib/db.js';

let productos = [];
try {
  const result = await db.query('SELECT * FROM productos ORDER BY id DESC');
  productos = result.rows || [];
} catch (e) {
  console.error('Error al consultar productos SSR:', e);
}
---

<Layout title="Gestión de Productos — TumiFact">
  <div class="space-y-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-6">
      <div>
        <h1 class="text-2xl font-bold font-['Outfit'] text-white">
          📦 Catálogo de Productos
        </h1>
        <p class="text-slate-400 text-sm mt-1">
          Inventario y lista de precios por kilogramo, libra o unidad con creación dinámica.
        </p>
      </div>
      <div class="flex items-center gap-3">
        <span class="px-3 py-1 bg-blue-500/10 text-blue-400 border border-blue-500/20 text-xs font-semibold rounded-full flex items-center gap-1.5">
          <span class="h-2 w-2 rounded-full bg-blue-400 animate-pulse"></span>
          React Island (<code class="text-xs">client:idle</code>)
        </span>
      </div>
    </div>

    <!-- React Island de Gestión de Productos -->
    <ProductGrid client:idle initialProductos={productos} />
  </div>
</Layout>
