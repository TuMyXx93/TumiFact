---
import ProductGrid from '../components/productos/ProductGrid';
import Layout from '../layouts/Layout.astro';
import db from '../lib/db.js';

let productos = [];
let categorias = [];
let proveedores = [];
try {
  const [prodRes, catRes, provRes] = await Promise.all([
    db.query(`
      SELECT p.*, c.nombre as categoria_nombre, c.tipo as categoria_tipo,
             pv.nombre as proveedor_nombre
      FROM productos p
      LEFT JOIN categorias_producto c ON p.categoria_id = c.id
      LEFT JOIN proveedores pv ON p.proveedor_id = pv.id
      ORDER BY p.id DESC
    `),
    db.query('SELECT * FROM categorias_producto WHERE activo = true ORDER BY id ASC'),
    db.query(
      'SELECT id, nombre, numero_identificacion, activo FROM proveedores WHERE activo = true ORDER BY nombre ASC'
    ),
  ]);
  productos = prodRes.rows || [];
  categorias = catRes.rows || [];
  proveedores = provRes.rows || [];
} catch (e) {
  console.error('Error al consultar productos SSR:', e);
}
---

<Layout title="Catálogo y Productos — TumiFact 2026">
  <div class="space-y-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-6">
      <div>
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-blue-500/10 text-blue-400 border border-blue-500/20 uppercase tracking-wider">
            CATALOG-SVC • ESPECIFICACIÓN 2026
          </span>
        </div>
        <h1 class="text-2xl md:text-3xl font-extrabold font-['Space_Grotesk'] text-white tracking-tight mt-1">
          Catálogo & Familias de Productos
        </h1>
        <p class="text-slate-400 text-xs sm:text-sm mt-1">
          Gestión integral de ropa, tecnología, calzado y artículos varios con precios al detal y mayorista.
        </p>
      </div>
    </div>

    <!-- React Island de Gestión de Productos Multi-Categoría -->
    <ProductGrid
      client:load
      initialProductos={productos}
      initialCategorias={categorias}
      initialProveedores={proveedores}
    />
  </div>
</Layout>
