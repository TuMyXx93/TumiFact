---
import Layout from '../layouts/Layout.astro';
import ClientManager from '../components/clientes/ClientManager';
import db from '../lib/db.js';

let clientes = [];
try {
  const result = await db.query('SELECT * FROM clientes ORDER BY id DESC');
  clientes = result.rows || [];
} catch (e) {
  console.error('Error al consultar clientes SSR:', e);
}
---

<Layout title="Gestión de Clientes — TumiFact">
  <div class="space-y-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-6">
      <div>
        <h1 class="text-2xl font-bold font-['Outfit'] text-white">
          👥 Directorio de Clientes
        </h1>
        <p class="text-slate-400 text-sm mt-1">
          Directorio de clientes registrados y gestión de datos de contacto.
        </p>
      </div>
      <div class="flex items-center gap-3">
        <span class="px-3 py-1 bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 text-xs font-semibold rounded-full flex items-center gap-1.5">
          <span class="h-2 w-2 rounded-full bg-cyan-400 animate-pulse"></span>
          React Island (<code class="text-xs">client:visible</code>)
        </span>
      </div>
    </div>

    <!-- React Island de Gestión de Clientes -->
    <ClientManager client:visible initialClientes={clientes} />
  </div>
</Layout>
