---
import Layout from '../layouts/Layout.astro';
---

<Layout title="TumiFact - Dashboard">
  <div class="space-y-8">
    <!-- Header Dashboard -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 p-6 rounded-2xl border border-slate-800 shadow-xl">
      <div>
        <h1 class="text-2xl md:text-3xl font-bold font-['Outfit'] text-white">
          Sistema de Facturación
        </h1>
        <p class="text-slate-400 text-sm mt-1">
          Bienvenido al centro de control de facturación.
        </p>
      </div>
      <div class="flex items-center gap-3">
        <a href="/ventas" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-500 hover:to-cyan-400 text-white font-semibold text-sm shadow-lg shadow-blue-500/25 transition-all transform hover:-translate-y-0.5">
          + Nueva Factura (POS)
        </a>
      </div>
    </div>

    <!-- Secciones Rápidas -->
    <div class="grid grid-cols-1 gap-6">
      <div class="bg-slate-900/60 p-6 rounded-2xl border border-slate-800 space-y-4">
        <h2 class="text-lg font-bold text-white font-['Outfit'] flex items-center gap-2">
          📋 Accesos Rápidos del Sistema
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a href="/productos" class="p-4 rounded-xl bg-slate-800/40 border border-slate-700/50 hover:bg-slate-800/80 transition-all flex items-center justify-between group">
            <div>
              <h3 class="font-semibold text-slate-200 group-hover:text-blue-400 transition-colors">Gestión de Productos</h3>
              <p class="text-xs text-slate-400">Catálogo, precios por KG/LB/UND e inventario</p>
            </div>
            <span class="text-slate-500 group-hover:translate-x-1 transition-transform">→</span>
          </a>

          <a href="/clientes" class="p-4 rounded-xl bg-slate-800/40 border border-slate-700/50 hover:bg-slate-800/80 transition-all flex items-center justify-between group">
            <div>
              <h3 class="font-semibold text-slate-200 group-hover:text-blue-400 transition-colors">Gestión de Clientes</h3>
              <p class="text-xs text-slate-400">Directorio, NIT/Cédula e historial</p>
            </div>
            <span class="text-slate-500 group-hover:translate-x-1 transition-transform">→</span>
          </a>

          <a href="/ventas" class="p-4 rounded-xl bg-slate-800/40 border border-slate-700/50 hover:bg-slate-800/80 transition-all flex items-center justify-between group">
            <div>
              <h3 class="font-semibold text-slate-200 group-hover:text-blue-400 transition-colors">Caja / Facturación POS</h3>
              <p class="text-xs text-slate-400">Generación inmediata con cálculo de totales</p>
            </div>
            <span class="text-slate-500 group-hover:translate-x-1 transition-transform">→</span>
          </a>

          <a href="/historial" class="p-4 rounded-xl bg-slate-800/40 border border-slate-700/50 hover:bg-slate-800/80 transition-all flex items-center justify-between group">
            <div>
              <h3 class="font-semibold text-slate-200 group-hover:text-blue-400 transition-colors">Historial de Ventas</h3>
              <p class="text-xs text-slate-400">Consulta y seguimiento de ventas registradas</p>
            </div>
            <span class="text-slate-500 group-hover:translate-x-1 transition-transform">→</span>
          </a>

          <a href="/configuracion" class="p-4 rounded-xl bg-slate-800/40 border border-slate-700/50 hover:bg-slate-800/80 transition-all flex items-center justify-between group">
            <div>
              <h3 class="font-semibold text-slate-200 group-hover:text-blue-400 transition-colors">Configuración</h3>
              <p class="text-xs text-slate-400">Datos de empresa, Logo y QR de pagos</p>
            </div>
            <span class="text-slate-500 group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
