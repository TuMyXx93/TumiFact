---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dashboard — TumiFact Enterprise">
  <div class="space-y-8">
    <!-- Header Dashboard -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 p-6 rounded-2xl border border-slate-800 shadow-xl">
      <div>
        <h1 class="text-2xl md:text-3xl font-bold font-['Outfit'] text-white">
          Sistema de Facturación TumiFact 🚀
        </h1>
        <p class="text-slate-400 text-sm mt-1">
          Bienvenido al centro de control de facturación enterprise. Frontend migrado a Astro v7.0 con Islands Architecture.
        </p>
      </div>
      <div class="flex items-center gap-3">
        <a href="/ventas" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-500 hover:to-cyan-400 text-white font-semibold text-sm shadow-lg shadow-blue-500/25 transition-all transform hover:-translate-y-0.5">
          + Nueva Factura (POS)
        </a>
      </div>
    </div>

    <!-- Cards de Estado y Métricas -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-slate-900/60 p-5 rounded-xl border border-slate-800 hover:border-slate-700 transition-colors">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Estado del Servidor</span>
          <span class="p-2 bg-blue-500/10 text-blue-400 rounded-lg">⚡</span>
        </div>
        <div class="mt-3">
          <span class="text-2xl font-bold text-white font-['Outfit']">Astro SSR</span>
          <p class="text-xs text-emerald-400 mt-1">✓ Node Adapter Standalone Activo</p>
        </div>
      </div>

      <div class="bg-slate-900/60 p-5 rounded-xl border border-slate-800 hover:border-slate-700 transition-colors">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Base de Datos</span>
          <span class="p-2 bg-emerald-500/10 text-emerald-400 rounded-lg">🗄️</span>
        </div>
        <div class="mt-3">
          <span class="text-2xl font-bold text-white font-['Outfit']">PostgreSQL 18.4</span>
          <p class="text-xs text-slate-400 mt-1">Contenedor: <code class="text-blue-300">tumifact_db</code></p>
        </div>
      </div>

      <div class="bg-slate-900/60 p-5 rounded-xl border border-slate-800 hover:border-slate-700 transition-colors">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Modo Frontend</span>
          <span class="p-2 bg-purple-500/10 text-purple-400 rounded-lg">🎨</span>
        </div>
        <div class="mt-3">
          <span class="text-2xl font-bold text-white font-['Outfit']">Tailwind CSS v4</span>
          <p class="text-xs text-purple-400 mt-1">Design System HSL Dark Mode</p>
        </div>
      </div>

      <div class="bg-slate-900/60 p-5 rounded-xl border border-slate-800 hover:border-slate-700 transition-colors">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Interactividad</span>
          <span class="p-2 bg-amber-500/10 text-amber-400 rounded-lg">⚛️</span>
        </div>
        <div class="mt-3">
          <span class="text-2xl font-bold text-white font-['Outfit']">React Islands</span>
          <p class="text-xs text-amber-400 mt-1">Hidratación Selectiva Activada</p>
        </div>
      </div>
    </div>

    <!-- Secciones Rápidas -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2 bg-slate-900/60 p-6 rounded-2xl border border-slate-800 space-y-4">
        <h2 class="text-lg font-bold text-white font-['Outfit'] flex items-center gap-2">
          📋 Accesos Rápidos del Sistema
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a href="/productos" class="p-4 rounded-xl bg-slate-800/40 border border-slate-700/50 hover:bg-slate-800/80 transition-all flex items-center justify-between group">
            <div>
              <h3 class="font-semibold text-slate-200 group-hover:text-blue-400 transition-colors">Gestión de Productos</h3>
              <p class="text-xs text-slate-400">Catálogo, precios por KG/LB/UND e inventario</p>
            </div>
            <span class="text-slate-500 group-hover:translate-x-1 transition-transform">→</span>
          </a>

          <a href="/clientes" class="p-4 rounded-xl bg-slate-800/40 border border-slate-700/50 hover:bg-slate-800/80 transition-all flex items-center justify-between group">
            <div>
              <h3 class="font-semibold text-slate-200 group-hover:text-blue-400 transition-colors">Gestión de Clientes</h3>
              <p class="text-xs text-slate-400">Directorio, NIT/Cédula e historial</p>
            </div>
            <span class="text-slate-500 group-hover:translate-x-1 transition-transform">→</span>
          </a>

          <a href="/ventas" class="p-4 rounded-xl bg-slate-800/40 border border-slate-700/50 hover:bg-slate-800/80 transition-all flex items-center justify-between group">
            <div>
              <h3 class="font-semibold text-slate-200 group-hover:text-blue-400 transition-colors">Caja / Facturación POS</h3>
              <p class="text-xs text-slate-400">Generación inmediata con cálculo de totales</p>
            </div>
            <span class="text-slate-500 group-hover:translate-x-1 transition-transform">→</span>
          </a>

          <a href="/configuracion" class="p-4 rounded-xl bg-slate-800/40 border border-slate-700/50 hover:bg-slate-800/80 transition-all flex items-center justify-between group">
            <div>
              <h3 class="font-semibold text-slate-200 group-hover:text-blue-400 transition-colors">Configuración</h3>
              <p class="text-xs text-slate-400">Datos de empresa, Logo y QR de pagos</p>
            </div>
            <span class="text-slate-500 group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      </div>

      <!-- Resumen de Arquitectura -->
      <div class="bg-slate-900/60 p-6 rounded-2xl border border-slate-800 space-y-4">
        <h2 class="text-lg font-bold text-white font-['Outfit']">
          💡 Estado de Migración
        </h2>
        <div class="space-y-3 text-xs">
          <div class="flex items-center justify-between p-2.5 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-300">
            <span>Fase 1: Configuración Entorno</span>
            <span class="font-bold">✅ Listo</span>
          </div>
          <div class="flex items-center justify-between p-2.5 rounded-lg bg-blue-500/10 border border-blue-500/20 text-blue-300">
            <span>Fase 2: Layouts & Pages</span>
            <span class="font-bold">⏳ Siguiente</span>
          </div>
          <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-800/40 text-slate-400">
            <span>Fase 3: React Islands</span>
            <span>Pendiente</span>
          </div>
          <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-800/40 text-slate-400">
            <span>Fase 4: Impresión & SSR</span>
            <span>Pendiente</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
