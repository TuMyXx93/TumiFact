---
import Layout from '../layouts/Layout.astro';
import InventarioManager from '../components/inventario/InventarioManager';
---

<Layout title="Control de Inventario & Kardex — TumiFact POS">
  <div class="space-y-6">
    <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-['Outfit']">
          Inventario & Trazabilidad Kardex
        </h1>
        <p class="text-sm text-slate-400 mt-1">
          Historial inmutable de movimientos, entradas por compras y alertas de stock mínimo.
        </p>
      </div>
    </header>

    <InventarioManager client:load />
  </div>
</Layout>
