---
import Layout from '../layouts/Layout.astro';
import CajaManager from '../components/caja/CajaManager';
---

<Layout title="Control de Caja — TumiFact POS">
  <div class="space-y-6">
    <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-['Outfit']">
          Control de Caja & Arqueos
        </h1>
        <p class="text-sm text-slate-400 mt-1">
          Apertura y cierre de turnos con balance auditado en tiempo real.
        </p>
      </div>
    </header>

    <CajaManager client:load />
  </div>
</Layout>
