---
import ProveedoresManager from '../components/proveedores/ProveedoresManager';
import Layout from '../layouts/Layout.astro';
import db from '../lib/db.js';

const currentUser = Astro.locals.user as any;

// Protección RBAC en SSR: Requiere sesión activa
if (!currentUser) {
  return Astro.redirect('/login');
}

let proveedores = [];
try {
  const result = await db.query(
    'SELECT * FROM proveedores WHERE activo = true ORDER BY nombre ASC'
  );
  proveedores = result.rows || [];
} catch (e) {
  console.error('Error al consultar proveedores SSR:', e);
}
---

<Layout title="Gestión de Proveedores — TumiFact POS">
  <div class="space-y-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-6">
      <div>
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 uppercase tracking-wider">
            SUPPLY-CHAIN • PROVEEDORES
          </span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold font-['Outfit'] text-white tracking-tight mt-1 flex items-center gap-2.5">
          🏢 Directorio de Proveedores
        </h1>
        <p class="text-slate-400 text-xs sm:text-sm mt-1">
          Gestión de distribuidores mayoristas, condiciones comerciales, plazos de crédito y canales de contacto.
        </p>
      </div>
    </div>

    <!-- React Island de Gestión de Proveedores -->
    <ProveedoresManager client:load initialProveedores={proveedores} />
  </div>
</Layout>
