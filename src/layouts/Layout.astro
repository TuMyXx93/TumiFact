---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'TumiFact — Sistema de Facturación Enterprise',
  description = 'Sistema de Facturación Enterprise TumiFact'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-[#0b0f19] text-slate-100 antialiased selection:bg-blue-600 selection:text-white flex flex-col">
    <!-- Header / Navbar Principal -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-[#0f172a]/80 border-b border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="h-9 w-9 rounded-xl bg-gradient-to-tr from-blue-600 to-cyan-400 flex items-center justify-center font-bold text-white shadow-lg shadow-blue-500/20 font-['Outfit']">
            TF
          </div>
          <div>
            <span class="font-['Outfit'] font-bold text-lg text-white tracking-tight">TumiFact</span>
            <span class="text-xs bg-blue-500/10 text-blue-400 px-2 py-0.5 rounded-full border border-blue-500/20 ml-2 font-medium">Enterprise v1.0</span>
          </div>
        </div>

        <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
          <a href="/" class="text-slate-200 hover:text-blue-400 transition-colors flex items-center gap-2">
            Dashboard
          </a>
          <a href="/productos" class="text-slate-400 hover:text-blue-400 transition-colors flex items-center gap-2">
            Productos
          </a>
          <a href="/clientes" class="text-slate-400 hover:text-blue-400 transition-colors flex items-center gap-2">
            Clientes
          </a>
          <a href="/ventas" class="text-slate-400 hover:text-blue-400 transition-colors flex items-center gap-2">
            Facturación / POS
          </a>
          <a href="/configuracion" class="text-slate-400 hover:text-blue-400 transition-colors flex items-center gap-2">
            Configuración
          </a>
        </nav>

        <div class="flex items-center gap-3">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
            BD Conectada
          </span>
        </div>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800/60 py-6 text-center text-xs text-slate-500">
      <p>© 2026 TumiFact Enterprise Billing System · Desarrollado con Astro 7.0 & Express PostgreSQL</p>
    </footer>
  </body>
</html>
