---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'TumiFact v2.0 — Sistema de Facturación & POS',
  description = 'Sistema de Facturación y Punto de Venta POS 2026',
} = Astro.props;

const publicApiBaseUrl = (import.meta.env.PUBLIC_API_BASE_URL || '').trim();
const publicApiPort = (import.meta.env.PUBLIC_API_PORT || '').trim();
const publicApiPorts = (import.meta.env.PUBLIC_API_PORTS || '').trim();
const publicApiAutoDiscovery = (import.meta.env.PUBLIC_API_AUTO_DISCOVERY || 'true')
  .trim()
  .toLowerCase();
const publicApiPortScanRange = (import.meta.env.PUBLIC_API_PORT_SCAN_RANGE || '3000-3999').trim();

const currentPath = Astro.url.pathname;
const isLoginPage = currentPath === '/login';
const user = Astro.locals.user as any;

const baseNavItems = [
  { href: '/', label: 'Dashboard' },
  { href: '/ventas', label: 'Terminal POS' },
  { href: '/separados', label: 'Separados' },
  { href: '/caja', label: 'Control Caja' },
  { href: '/inventario', label: 'Inventario' },
  { href: '/productos', label: 'Productos' },
  { href: '/clientes', label: 'Clientes' },
  { href: '/proveedores', label: 'Proveedores', requiresAdmin: true },
  { href: '/empleados', label: 'Empleados', requiresAdmin: true },
  { href: '/reportes', label: 'Reportes' },
  { href: '/historial', label: 'Historial' },
  { href: '/configuracion', label: 'Config' },
];

const isAdminOrGerente = user?.rol_nombre === 'admin' || user?.rol_nombre === 'gerente';
const navItems = baseNavItems.filter((item) => !item.requiresAdmin || isAdminOrGerente);
---

<!DOCTYPE html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2563eb" />
    <link rel="manifest" href="/manifest.json" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@500;600;700;800;900&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-[#060913] text-slate-100 antialiased selection:bg-blue-600 selection:text-white flex flex-col font-['Inter']">
    <!-- Header / Navbar Principal -->
    <header class="sticky top-0 z-50 backdrop-blur-xl bg-[#0d1424]/90 border-b border-slate-800/80 shadow-2xl">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
        
        <!-- Logo & Marca -->
        <div class="flex items-center gap-3 shrink-0">
          <a href="/" class="flex items-center gap-2 group">
            <div class="flex flex-col">
              <span class="font-['Outfit'] font-black text-xl text-white tracking-tight leading-none group-hover:text-blue-300 transition-colors">
                TumiFact
              </span>
              <span class="text-[10px] text-blue-400 font-bold uppercase tracking-wider font-mono">
                v2.0 POS
              </span>
            </div>
          </a>
        </div>

        <!-- Navegación de Escritorio (Si no es página de login) -->
        {!isLoginPage && (
          <nav class="hidden xl:flex items-center gap-1 text-xs font-semibold">
            {navItems.map((item) => {
              const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
              return (
                <a
                  href={item.href}
                  class={`px-3 py-1.5 rounded-xl transition-all ${
                    isActive
                      ? 'bg-blue-600/20 text-blue-400 border border-blue-500/30 font-bold shadow-sm'
                      : 'text-slate-300 hover:text-white hover:bg-slate-800/60'
                  }`}
                >
                  <span>{item.label}</span>
                </a>
              );
            })}
          </nav>
        )}

        <!-- Acciones Derecha: Estado BD, Perfil Usuario & Salir -->
        <div class="flex items-center gap-3 shrink-0">
          <!-- DB Status Badge -->
          <span
            id="db-status-badge"
            data-state="connecting"
            data-api-base={publicApiBaseUrl}
            data-api-port={publicApiPort}
            data-api-ports={publicApiPorts}
            data-api-auto-discovery={publicApiAutoDiscovery}
            data-api-port-range={publicApiPortScanRange}
            class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20 transition-colors font-mono"
            aria-live="polite"
          >
            <span id="db-status-dot" class="h-2 w-2 rounded-full bg-amber-400 animate-pulse"></span>
            <span id="db-status-label">BD...</span>
          </span>

          <!-- Usuario Logueado / Logout -->
          {!isLoginPage && user && (
            <div class="flex items-center gap-2 pl-2 border-l border-slate-800">
              <div class="hidden md:flex flex-col text-right">
                <span class="text-xs font-bold text-white leading-tight">
                  {user.nombre} {user.apellido || ''}
                </span>
                <span class="text-[10px] text-blue-400 uppercase font-mono font-semibold">
                  {user.rol_nombre || 'Operador'}
                </span>
              </div>

              <div class="h-8 w-8 rounded-xl bg-slate-800 border border-slate-700 flex items-center justify-center font-bold text-xs text-blue-400 shadow-inner font-['Outfit']">
                {(user.nombre || 'U').charAt(0).toUpperCase()}
              </div>

              <button
                id="logout-btn"
                type="button"
                title="Cerrar sesión segura"
                class="p-2 rounded-xl bg-slate-800/80 hover:bg-rose-500/20 text-slate-400 hover:text-rose-400 border border-slate-700/80 hover:border-rose-500/30 transition-all cursor-pointer"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
              </button>
            </div>
          )}

          <!-- Botón Menú Móvil -->
          {!isLoginPage && (
            <button
              id="mobile-menu-btn"
              type="button"
              class="xl:hidden p-2 rounded-xl bg-slate-800 text-slate-300 hover:text-white border border-slate-700"
            >
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          )}
        </div>
      </div>

      <!-- Drawer / Menú Móvil Desplegable -->
      {!isLoginPage && (
        <div id="mobile-menu" class="hidden xl:hidden border-t border-slate-800/80 bg-slate-900/95 px-4 py-4 space-y-2">
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
            {navItems.map((item) => {
              const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
              return (
                <a
                  href={item.href}
                  class={`p-2.5 rounded-xl text-xs font-semibold flex items-center justify-center transition-all ${
                    isActive
                      ? 'bg-blue-600 text-white font-bold'
                      : 'bg-slate-800/80 text-slate-300 hover:bg-slate-700 hover:text-white'
                  }`}
                >
                  <span>{item.label}</span>
                </a>
              );
            })}
          </div>
        </div>
      )}
    </header>

    <!-- Contenido Principal de la Aplicación -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800/60 py-6 text-center text-xs text-slate-500 bg-[#0a0f1d]">
      <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-3">
        <p>© 2026 TumiFact POS • Plataforma de Facturación & Inventario</p>
      </div>
    </footer>

    <!-- Script de Logout -->
    <script is:inline>
      document.getElementById('logout-btn')?.addEventListener('click', () => {
        // Limpiar storage local primero
        localStorage.removeItem('tumifact_token');
        localStorage.removeItem('tumifact_user');
        sessionStorage.clear();
        // Navegar al endpoint server-side que borra la cookie y redirige a /login
        // Esto elimina la condición de carrera del enfoque client-side
        window.location.href = '/logout';
      });

      const mobileBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      mobileBtn?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
      });
    </script>

    <!-- Probing y Monitoreo de Salud de la Base de Datos -->
    <script is:inline>
      (() => {
        const badge = document.getElementById('db-status-badge');
        const dot = document.getElementById('db-status-dot');
        const label = document.getElementById('db-status-label');
        if (!badge || !dot || !label) return;

        const configuredApiBaseUrl = (badge.dataset.apiBase || '').trim();
        const configuredApiPort = (badge.dataset.apiPort || '').trim();
        const configuredApiPorts = (badge.dataset.apiPorts || '').trim();
        const allowAutoDiscovery = (badge.dataset.apiAutoDiscovery || 'true').trim().toLowerCase() !== 'false';
        const configuredPortRange = (badge.dataset.apiPortRange || '3000-3999').trim();
        const healthyApiKey = 'tumifact.healthyApiBase';
        const localOverrideKey = 'tumifact.apiBaseUrl';
        let activeApiBase = null;
        let isChecking = false;
        let portScanAttempted = false;

        const stateClassMap = {
          connected: {
            badge: ['bg-emerald-500/10', 'text-emerald-400', 'border-emerald-500/20'],
            dot: ['bg-emerald-400', 'animate-pulse'],
            text: 'BD OK'
          },
          connecting: {
            badge: ['bg-amber-500/10', 'text-amber-400', 'border-amber-500/20'],
            dot: ['bg-amber-400', 'animate-pulse'],
            text: 'BD...'
          },
          disconnected: {
            badge: ['bg-rose-500/10', 'text-rose-400', 'border-rose-500/20'],
            dot: ['bg-rose-400'],
            text: 'BD OFF'
          }
        };

        const allBadgeClasses = [
          'bg-emerald-500/10', 'text-emerald-400', 'border-emerald-500/20',
          'bg-amber-500/10', 'text-amber-400', 'border-amber-500/20',
          'bg-rose-500/10', 'text-rose-400', 'border-rose-500/20'
        ];
        const allDotClasses = ['bg-emerald-400', 'bg-amber-400', 'bg-rose-400', 'animate-pulse'];

        const normalizeBase = (value) => {
          if (!value || typeof value !== 'string') return null;
          return value.trim().replace(/\/+$/, '');
        };

        const parseCsvPorts = (value) => {
          if (!value) return [];
          return value
            .split(',')
            .map((p) => Number.parseInt(p.trim(), 10))
            .filter((port) => Number.isInteger(port) && port > 0 && port < 65536);
        };

        const parseRangePorts = (value) => {
          const trimmed = value.trim();
          if (!trimmed.includes('-')) {
            const singlePort = Number.parseInt(trimmed, 10);
            return Number.isInteger(singlePort) && singlePort > 0 && singlePort < 65536 ? [singlePort] : [];
          }

          const [startRaw, endRaw] = trimmed.split('-', 2);
          const start = Number.parseInt(startRaw, 10);
          const end = Number.parseInt(endRaw, 10);
          if (!Number.isInteger(start) || !Number.isInteger(end)) return [];

          const min = Math.max(1, Math.min(start, end));
          const max = Math.min(65535, Math.max(start, end));
          if (max - min > 2000) return [];

          const ports = [];
          for (let port = min; port <= max; port += 1) ports.push(port);
          return ports;
        };

        const formatCheckedAt = (date) => {
          try {
            return new Intl.DateTimeFormat('es-CO', {
              hour: '2-digit',
              minute: '2-digit',
              second: '2-digit'
            }).format(date);
          } catch (_err) {
            return date.toLocaleTimeString();
          }
        };

        const buildApiCandidates = () => {
          const protocol = window.location.protocol;
          const host = window.location.hostname;
          const queryParams = new URLSearchParams(window.location.search);
          const queryBase = normalizeBase(queryParams.get('apiBase') || queryParams.get('api'));
          const persistedBase = normalizeBase(sessionStorage.getItem(healthyApiKey));
          const localBase = normalizeBase(localStorage.getItem(localOverrideKey));
          const globalBase = normalizeBase(window.__TUMIFACT_API_BASE__);
          const candidates = [
            normalizeBase(configuredApiBaseUrl),
            queryBase,
            globalBase,
            persistedBase,
            localBase,
            normalizeBase(window.location.origin)
          ];

          const csvPorts = parseCsvPorts(configuredApiPorts);
          if (host === 'localhost' || host === '127.0.0.1') {
            if (configuredApiPort) {
              const singlePort = Number.parseInt(configuredApiPort, 10);
              if (Number.isInteger(singlePort) && singlePort > 0 && singlePort < 65536) {
                candidates.push(normalizeBase(`${protocol}//${host}:${singlePort}`));
              }
            }
            for (const port of csvPorts) {
              candidates.push(normalizeBase(`${protocol}//${host}:${port}`));
            }
          }

          return [...new Set(candidates.filter(Boolean))];
        };

        const scanLocalPorts = async () => {
          if (portScanAttempted || !allowAutoDiscovery) return null;

          const protocol = window.location.protocol;
          const host = window.location.hostname;
          if (!(host === 'localhost' || host === '127.0.0.1')) return null;

          portScanAttempted = true;
          const ports = parseRangePorts(configuredPortRange);
          if (ports.length === 0) return null;

          const batchSize = 24;
          for (let i = 0; i < ports.length; i += batchSize) {
            const batch = ports.slice(i, i + batchSize);
            const probeBatch = await Promise.all(
              batch.map(async (port) => {
                const candidate = `${protocol}//${host}:${port}`;
                const result = await probeHealth(candidate);
                return result.ok ? candidate : null;
              })
            );

            const healthyCandidate = probeBatch.find(Boolean);
            if (healthyCandidate) return healthyCandidate;
          }

          return null;
        };

        const setState = (state, details = {}) => {
          const config = stateClassMap[state] || stateClassMap.disconnected;
          const checkedAt = details.checkedAt || new Date();
          const checkedAtText = formatCheckedAt(checkedAt);

          badge.classList.remove(...allBadgeClasses);
          dot.classList.remove(...allDotClasses);

          badge.classList.add(...config.badge);
          dot.classList.add(...config.dot);

          badge.dataset.state = state;
          label.textContent = typeof details.latencyMs === 'number' && state === 'connected'
            ? `${config.text} (${details.latencyMs}ms)`
            : config.text;

          const apiBaseText = details.apiBase || activeApiBase || 'No detectada';
          badge.title = `${config.text} | API: ${apiBaseText} | Verificado: ${checkedAtText}`;
          badge.setAttribute('aria-label', badge.title);
        };

        const probeHealth = async (apiBase) => {
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), 1800);

          try {
            const startedAt = performance.now();
            const res = await fetch(`${apiBase}/api/health/db`, {
              method: 'GET',
              cache: 'no-store',
              signal: controller.signal
            });

            const elapsed = Math.round(performance.now() - startedAt);
            if (!res.ok) return { ok: false };

            const payload = await res.json();
            if (payload?.connected === true) {
              return {
                ok: true,
                latencyMs: typeof payload.latencyMs === 'number' ? payload.latencyMs : elapsed
              };
            }

            return { ok: false };
          } catch (_error) {
            return { ok: false };
          } finally {
            clearTimeout(timeoutId);
          }
        };

        const checkDbHealth = async (forceConnecting = false) => {
          if (isChecking) return;
          isChecking = true;

          try {
            if (forceConnecting || badge.dataset.state !== 'connected') {
              setState('connecting', { checkedAt: new Date() });
            }

            const prioritized = activeApiBase
              ? [activeApiBase, ...buildApiCandidates()]
              : buildApiCandidates();
            const candidates = [...new Set(prioritized.filter(Boolean))];

            for (const apiBase of candidates) {
              const result = await probeHealth(apiBase);
              if (result.ok) {
                activeApiBase = apiBase;
                window.__TUMIFACT_API_BASE__ = apiBase;
                sessionStorage.setItem(healthyApiKey, apiBase);
                localStorage.setItem(localOverrideKey, apiBase);
                setState('connected', {
                  latencyMs: result.latencyMs,
                  apiBase,
                  checkedAt: new Date()
                });
                return;
              }
            }

            const scannedCandidate = await scanLocalPorts();
            if (scannedCandidate) {
              activeApiBase = scannedCandidate;
              window.__TUMIFACT_API_BASE__ = scannedCandidate;
              sessionStorage.setItem(healthyApiKey, scannedCandidate);
              localStorage.setItem(localOverrideKey, scannedCandidate);
              setState('connected', {
                apiBase: scannedCandidate,
                checkedAt: new Date()
              });
              return;
            }

            activeApiBase = null;
            delete window.__TUMIFACT_API_BASE__;
            sessionStorage.removeItem(healthyApiKey);
            setState('disconnected', { checkedAt: new Date() });
          } finally {
            isChecking = false;
          }
        };

        checkDbHealth(true);
        // Health is a readiness signal; polling every 30s avoids creating
        // sustained API traffic while keeping the indicator responsive.
        setInterval(() => {
          checkDbHealth(false);
        }, 30000);

        window.addEventListener('online', () => checkDbHealth(true));
        window.addEventListener('offline', () => setState('disconnected', { checkedAt: new Date() }));
      })();
    </script>

    <!-- PWA Service Worker — Fase 4.2 -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
    <span id="offline-queue-badge" class="hidden fixed bottom-4 right-4 px-3 py-1.5 rounded-full text-xs font-bold bg-amber-500 text-white shadow-lg border border-amber-600 z-50"></span>
  </body>
</html>

<script>
  import { getQueueCount, replayQueuedFacturas } from '../lib/offline-queue';
  import { apiFetch } from '../lib/apiClient';

  const updateOfflineBadge = async () => {
    try {
      const count = await getQueueCount();
      const badge = document.getElementById('offline-queue-badge');
      if (badge) {
        if (count > 0) {
          badge.textContent = `${count} offline`;
          badge.classList.remove('hidden');
        } else {
          badge.classList.add('hidden');
        }
      }
    } catch {}
  };

  window.addEventListener('online', async () => {
    try {
      const result = await replayQueuedFacturas(apiFetch);
      if (result.replayed > 0) {
        console.info(`[OfflineQueue] ${result.replayed} facturas sincronizadas`);
        window.dispatchEvent(new CustomEvent('tumifact:offline-synced', { detail: result }));
      }
      updateOfflineBadge();
    } catch (e) {
      console.error('[OfflineQueue] replay error', e);
    }
  });

  setInterval(() => {
    if (navigator.onLine) window.dispatchEvent(new Event('online'));
    updateOfflineBadge();
  }, 60000);

  updateOfflineBadge();
</script>
