  ventas_efectivo        Decimal                  @default(0) @db.Decimal(12, 2)
  ventas_transferencia   Decimal                  @default(0) @db.Decimal(12, 2)
  ventas_tarjeta         Decimal                  @default(0) @db.Decimal(12, 2)
  total_ventas           Decimal                  @default(0) @db.Decimal(12, 2)
  total_devoluciones     Decimal                  @default(0) @db.Decimal(12, 2)
  total_separados_abonos Decimal                  @default(0) @db.Decimal(12, 2)
  numero_transacciones   Int                      @default(0)
  notas                  String?
  abierta_at             DateTime                 @default(now()) @db.Timestamp(6)
  cerrada_at             DateTime?                @db.Timestamp(6)
  created_at             DateTime?                @default(now()) @db.Timestamp(6)
  abonos_separado        abonos_separado[]
  audit_log              audit_log[]
  devoluciones           devoluciones[]
  facturas               facturas[]
  movimientos_inventario movimientos_inventario[]
  separados              separados[]
  usuarios               usuarios                 @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model tipos_identificacion {
  id          Int           @id @default(autoincrement())
  codigo      String        @unique @db.VarChar(10)
  nombre      String        @db.VarChar(100)
  aplica_a    String        @default("todos") @db.VarChar(20)
  clientes    clientes[]
  proveedores proveedores[]
  usuarios    usuarios[]
}

model usuarios {
  id                                                         Int                      @id @default(autoincrement())
  nombre                                                     String                   @db.VarChar(80)
  apellido                                                   String                   @db.VarChar(80)
  tipo_identificacion_id                                     Int?
  numero_identificacion                                      String?                  @unique @db.VarChar(30)
  email                                                      String                   @unique @db.VarChar(150)
  telefono                                                   String?                  @db.VarChar(20)
  direccion_id                                               Int?
  password_hash                                              String                   @db.VarChar(255)
  rol_id                                                     Int
  activo                                                     Boolean                  @default(true)
  ultimo_login                                               DateTime?                @db.Timestamp(6)
  intentos_fallidos                                          Int                      @default(0)
  bloqueado_hasta                                            DateTime?                @db.Timestamp(6)
  created_at                                                 DateTime?                @default(now()) @db.Timestamp(6)
  updated_at                                                 DateTime?                @default(now()) @db.Timestamp(6)
  abonos_separado                                            abonos_separado[]
  audit_log                                                  audit_log[]
