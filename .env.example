# =====================================================
# CONFIGURACIÓN DE BASE DE DATOS - POSTGRESQL 18.4
# =====================================================
# Docker Compose levanta PostgreSQL con estos parámetros
# Archivo: docker-compose.yml

# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=tumifact_user
DB_PASSWORD=tumifact_password
DB_DATABASE=tumifact_db

# =====================================================
# CONFIGURACIÓN DE LA APLICACIÓN
# =====================================================

PORT=3000
NODE_ENV=development

# Seguridad: sustituir por un secreto aleatorio de al menos 32 bytes
JWT_SECRET=replace-with-a-random-32-byte-secret
CORS_ORIGIN=http://localhost:4321
REDIS_URL=redis://localhost:6380
REDIS_CONNECT_TIMEOUT_MS=1000
API_RATE_LIMIT=300
REFRESH_RATE_LIMIT=20

# Contraseña usada por scripts/seed-admin.js para crear/actualizar los 3 usuarios demo
# (admin@tumifact.com, gerente@tumifact.com, ventas1@tumifact.com).
# Requisito: mínimo 12 caracteres. NO commitear el valor real en repos públicos.
SEED_ADMIN_PASSWORD=replace-with-a-strong-password-12+chars

# Contraseña que el frontend muestra en el bloque "Accesos Demo" de /login.
# Solo se renderiza cuando NODE_ENV=development; en producción el bloque se oculta.
# Mantener sincronizada con SEED_ADMIN_PASSWORD.
PUBLIC_DEMO_PASSWORD=replace-with-a-strong-password-12+chars
