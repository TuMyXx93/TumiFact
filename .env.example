# =====================================================
# CONFIGURACIÓN DE BASE DE DATOS - POSTGRESQL 18.4
# =====================================================
# Docker Compose levanta PostgreSQL en estos parámetros
# Archivo: docker-compose.yml

# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=fruver_user
DB_PASSWORD=fruver_password
DB_DATABASE=ecl_fruver

# =====================================================
# CONFIGURACIÓN DE LA APLICACIÓN
# =====================================================

PORT=3000
NODE_ENV=development
