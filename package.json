{
  "name": "tumifact",
  "version": "1.0.0",
  "description": "Sistema de Facturación TumiFact",
  "main": "server.js",
  "bin": "server.js",
  "pkg": {
    "assets": [
      "views/**/*",
      "public/**/*",
      "node_modules/ejs/**/*"
    ],
    "targets": [
      "node16-win-x86",
      "node16-linux-x86",
      "node16-macos-x86"
    ],
    "outputPath": "dist"
  },
  "scripts": {
    "start": "node dist/server/entry.mjs",
    "dev": "astro dev",
    "dev:api": "tsx watch src/server.ts",
    "build:api": "tsup src/server.ts --format esm,cjs",
    "build": "astro build",
    "preview": "astro preview",
    "clean": "rm -rf node_modules .pnpm-store pnpm-lock.yaml dist",
    "rebuild": "pnpm clean && pnpm install",
    "audit": "pnpm audit",
    "test": "vitest run --run",
    "test:legacy": "jest --runInBand",
    "test:api": "node --import tsx --test tests/api/*.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:legacy": "jest --coverage --runInBand",
    "test:setup": "node tests/db-test-setup.js",
    "check": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@astrojs/node": "^11.1.1",
    "@astrojs/react": "^6.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pdfkit": "^0.17.6",
    "@types/uuid": "^11.0.0",
    "argon2": "^0.45.1",
    "astro": "^7.2.1",
    "body-parser": "^1.20.6",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "jose": "^6.2.8",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.27.0",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rate-limit-redis": "^6.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "jest": "^29.7.0",
    "nodemon": "^2.0.22",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
