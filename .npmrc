# pnpm Configuration
# Optimizaciones y configuraciones profesionales para pnpm

# No levantar dependencias de pares al directorio raíz
shamefully-hoist=false

# Permitir dependencias de pares no estrictas (útil para compatibilidad)
strict-peer-dependencies=false

# Usar hard links para optimizar almacenamiento
hard-link-preference=hard-link

# Verificar integridad de los paquetes
verify-store-integrity=true

# Registrar el store de pnpm
store-dir=.pnpm-store
