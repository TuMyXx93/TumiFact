{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@tumifact/schemas": ["./packages/schemas/src"],
      "@tumifact/schemas/*": ["./packages/schemas/src/*"],
      "@tumifact/types": ["./packages/types/src"],
      "@tumifact/types/*": ["./packages/types/src/*"]
    }
  },
  "include": ["src/**/*", ".astro/types.d.ts"],
  "exclude": ["node_modules", "dist"]
}
